# Copy to .env and fill in. .env is gitignored, never commit it.

# Nebius Token Factory (OpenAI-compatible inference endpoint)
# Any of these names works: NEBIUS_API_KEY, INFERENCE_API_KEY, NEBIUS_INFERENCE_API_KEY
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Seconds to wait on one model call, and transport retries (defaults 120 and 3)
NEBIUS_TIMEOUT_S=
NEBIUS_MAX_RETRIES=

# Model IDs (see docs/nebius.md for the verified list)
NEMOTRON_TEXT_MODEL=
NEMOTRON_VISION_MODEL=

# What the bead camera sees. rendering on the simulator this project ships
# with, photograph on a real cell; the inspector's prompt says which it is.
BEAD_SOURCE=rendering
# Crop box the inspector sends, x0,y0,x1,y1 in pixels; none sends the whole
# frame. Unset means the simulator's window.
BEAD_WINDOW=

# Millimetre limits every page and prompt reads
CELL_WELDABLE_MM=1.0
CELL_PROBLEM_MM=3.0

# Local service
CELL_DB_URL=sqlite:///data/cell.db
CELL_API_URL=http://127.0.0.1:8000
CELL_API_TOKEN=

# Optional: web research tool for the supervisor agent
TAVILY_API_KEY=
