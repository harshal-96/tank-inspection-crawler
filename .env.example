# Copy to .env and fill in. .env is gitignored, never commit it.

# Nebius Token Factory (OpenAI-compatible inference endpoint)
# Any of these names works: NEBIUS_API_KEY, INFERENCE_API_KEY
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs (see docs/nebius.md for the verified list)
NEMOTRON_TEXT_MODEL=
NEMOTRON_VISION_MODEL=

# Local service
CELL_DB_URL=sqlite:///data/cell.db
CELL_API_URL=http://127.0.0.1:8000
CELL_API_TOKEN=

# Optional: web research tool for the supervisor agent
TAVILY_API_KEY=
