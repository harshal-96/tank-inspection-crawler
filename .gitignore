# Secrets
.env
.env.*
!.env.example
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Model weights and engines (tracked via releases, not git)
*.pt
*.onnx
*.engine
*.trt

# What scripts/demo.py writes. The demo runs the real pipeline, so it produces
# real results, but they are six parts rather than fifty and must never be
# mistaken for the campaign files beside them that the README quotes.
data/demo_run/

# Generated data
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.log
data/inspections/
data/datasets/
runs/
renders/

# Raw capture output. Hundreds of megabytes of depth buffers and renders per
# campaign, regenerated by running the station. The scored RESULTS of a campaign
# are small and ARE tracked, because they are the evidence for the numbers in the
# README and a reader must be able to check them without a GPU.
data/captures/
data/captures_*/
data/captures_show/
data/cap50/
data/cubeprobe/

# Working renders from framing and debugging passes. The figures that are
# referenced anywhere are kept; these are the ones that were thrown away.
data/angle_*.png
data/r_[a-e].png
data/c[12].png
data/now.png
data/tray.png
data/bent_corner.png
data/blender_tray.png
data/look_p9_*.png
data/meshcheck.json

# Isaac Sim / USD scratch
*.usd
*.usda
*.usdc
!assets/**/*.usd

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local dev tooling (machine-specific absolute paths)
.claude/

# Fine-tuning artefacts. The adapter is 80 MB of weights that a release carries,
# not git, and the training set is regenerated byte-identically by
# scripts/make_drift_dataset.py from a seed. What IS tracked is the job record and
# the scored results, because those are the evidence for the claim.
data/finetune/adapter/
data/finetune/drift_train.jsonl
data/finetune/drift_val.jsonl
